{
  "canisters": {
    "auditorbox_backend": {
      "main": "backend/main.mo",
      "type": "motoko",
      "args": "--enhanced-orthogonal-persistence",
      "wasm_memory_persistence": "keep"
    },
    "auditorbox_frontend": {
      "type": "assets",
      "source": [
        "frontend-dist"
      ],
      "dependencies": [
        "auditorbox_backend"
      ]
    }
  },
  "output_env_file": ".env",
  "defaults": {
    "build": {
      "packtool": ""
    }
  }
}